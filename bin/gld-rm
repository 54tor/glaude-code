#!/usr/bin/env bash
# gld-rm — supprime des sessions Claude et tout ce qui s'y rattache.
#
#   gld-rm <id|motif>...       supprime les sessions désignées (demande confirmation)
#   gld-rm -n <motif>          dry-run : montre ce qui partirait
#   gld-rm --vides             les sessions sans conversation exploitable
#   gld-rm --plus-vieux 60     celles inactives depuis plus de N jours
#   gld-rm -f <motif>          sans confirmation
#   gld-rm --projet ~/p <...>  cible un autre projet
#
# <motif> : un début d'ID (ex: 49c0e7ca) ou un fragment de nom (ex: "Traducteur").
#
# La suppression est DÉFINITIVE : Claude ne connaît pas de corbeille pour les
# transcripts. Une session vivante n'est jamais supprimée. Part avec elle tout
# ce qu'elle possède ailleurs : sous-agents, file-history/, session-env/,
# tasks/, teams/, jobs/, uploads/, debug/, ses collages, son instantané de shell
# et ses lignes de history.jsonl. Les restes des suppressions d'avant se
# balayent avec `gld-trier --orphelins`.
#
# Portable bash 3.2+, GNU/BSD/macOS. Dépend de jq et claude.

set -uo pipefail
. "$(dirname "$0")/gld-lib.sh"

DRY=0; FORCE=0; VIDES=0; PLUSVIEUX=""; CIBLE=""; MOTIFS=""

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run)   DRY=1 ;;
    -f|--force)     FORCE=1 ;;
    --vides)        VIDES=1 ;;
    --plus-vieux)   PLUSVIEUX="${2:-}"; shift ;;
    --projet)       CIBLE="${2:-}"; shift ;;
    -h|--help)      sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)             echo "gld-rm: option inconnue: $1" >&2; exit 2 ;;
    *)              MOTIFS="$MOTIFS
$1" ;;
  esac
  shift
done

resoudre_projet "$CIBLE"

[ -n "$MOTIFS" ] || [ "$VIDES" = 1 ] || [ -n "$PLUSVIEUX" ] || {
  echo "gld-rm: rien à supprimer. Donnez un id/motif, --vides ou --plus-vieux N." >&2
  echo "       gld-rm -h pour l'aide." >&2
  exit 2
}

echo "projet : $PROJET"
echo

VIVANTES=$(sessions_vivantes)

# Une session est «vide» si Claude n'y voit pas de conversation : en pratique
# un transcript minuscule, sans titre ni prompt exploitable. Vérifié : sur un
# tel fichier, `claude --resume` répond «No conversation found».
#
# Un parent vide PORTANT DES SOUS-AGENTS n'est pas vide : le travail est dans
# les sous-agents, et les supprimer les emporterait. On les épargne.
est_vide() {
  [ "$(taille "$1")" -lt 2000 ] || return 1
  [ -z "$(titre_explicite "$1")" ] || return 1
  [ -z "$(etiquette_deduite "$1")" ] || return 1
  sub="${1%.jsonl}"
  [ -d "$sub" ] && find "$sub" -type f -name '*.jsonl' 2>/dev/null | grep -q . && return 1
  return 0
}

correspond() {
  f="$1"; id="$2"
  [ "$VIDES" = 1 ] && est_vide "$f" && return 0
  if [ -n "$PLUSVIEUX" ]; then
    find "$f" -mtime +"$PLUSVIEUX" 2>/dev/null | grep -q . && return 0
  fi
  [ -n "$MOTIFS" ] || return 1
  titre=$(titre_explicite "$f"); [ -n "$titre" ] || titre=$(etiquette_deduite "$f")
  printf '%s\n' "$MOTIFS" | grep -v '^$' | while IFS= read -r m; do
    case "$id" in "$m"*) echo match; break ;; esac
    printf '%s' "$titre" | grep -Fqi -- "$m" && { echo match; break; }
  done | grep -q match
}

# --- sélection ---------------------------------------------------------------

CANDIDATS=""; total=0
for f in $(ls -t "$TRANSCRIPTS"/*.jsonl 2>/dev/null); do
  id=$(basename "$f" .jsonl)
  correspond "$f" "$id" || continue

  if printf '%s\n' "$VIVANTES" | grep -Fq -- "$id"; then
    printf '  PROTÉGÉE (vivante)  %s  %s\n' "$(printf '%.8s' "$id")" "$(titre_explicite "$f")"
    continue
  fi

  titre=$(titre_explicite "$f"); [ -n "$titre" ] || titre="~ $(etiquette_deduite "$f")"

  # Le répertoire d'une session mêle subagents/ (des conversations, qui comptent)
  # et tool-results/ (des sorties d'outils déportées, sans valeur propre).
  sub="$TRANSCRIPTS/$id"
  nsub=0
  [ -d "$sub" ] && nsub=$(find "$sub" -type f -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ')

  printf '  %-9s %-45s %s  %6sK  %s sous-agent(s)\n' \
    "$(mdate "$f")" "$(printf '%.45s' "$titre")" "$(printf '%.8s' "$id")" \
    "$(( $(taille "$f") / 1024 ))" "$nsub"

  CANDIDATS="$CANDIDATS
$id"
  total=$((total + 1))
done

echo
[ "$total" -gt 0 ] || { echo "aucune session ne correspond."; exit 0; }

if [ "$DRY" = 1 ]; then
  echo "$total session(s) seraient supprimées. Lancez sans -n pour appliquer."
  exit 0
fi

if [ "$FORCE" != 1 ]; then
  printf 'Supprimer DÉFINITIVEMENT ces %s session(s) ? [tapez oui] ' "$total"
  read -r rep < /dev/tty || rep=""
  [ "$rep" = "oui" ] || { echo "annulé."; exit 1; }
fi

cc_tmp
: > "$GLD_TMP/supprimees"; : > "$GLD_TMP/snapshots"

printf '%s\n' "$CANDIDATS" | grep -v '^$' | while IFS= read -r id; do
  # Le nom de l'instantané de shell ne vit que dans le transcript : le relever
  # avant de détruire, sinon le fichier reste orphelin pour toujours.
  snapshots_cites "$TRANSCRIPTS/$id.jsonl" "$TRANSCRIPTS/$id" >> "$GLD_TMP/snapshots"
  n=$(purger_session "$TRANSCRIPTS" "$id" | wc -l | tr -d ' ')
  printf '%s\n' "$id" >> "$GLD_TMP/supprimees"
  printf '  supprimée  %s  (%s emplacement(s))\n' "$(printf '%.8s' "$id")" "$n"
done

echo
echo "$total session(s) supprimées."
solder "$GLD_TMP/supprimees" "$GLD_TMP/snapshots"
