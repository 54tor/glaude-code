#!/usr/bin/env bash
# gld-trier — passe en revue les sessions NON OUVERTES, une par une, pour choisir
#            lesquelles supprimer. Les sessions vivantes sont exclues d'office.
#
#   gld-trier                  du plus ancien au plus récent (défaut)
#   gld-trier --recent         du plus récent au plus ancien
#   gld-trier -n               liste seulement les candidates, ne demande rien
#   gld-trier ~/Projets/x      cible un autre projet
#   gld-trier --age 60         ne montre que les sessions inactives depuis +60 j
#   gld-trier --tout           supprime d'un coup TOUTES les non ouvertes du projet
#   gld-trier --partout        idem, sur tous les projets à la fois
#   gld-trier --orphelins      balaye les restes des sessions déjà supprimées
#   gld-trier --orphelins -n   inventaire chiffré, sans rien effacer
#   gld-trier ... -f           sans confirmation
#
# --tout et --partout listent d'abord, puis demandent « oui » une seule fois.
# Combinés à --orphelins, ils enchaînent avec le balayage : tout part.
# Ils obéissent à --age et --min : `--tout --age 30` épargne le mois écoulé.
#
# À chaque session : [Entrée]=garder  s=supprimer  v=voir plus  q=quitter.
# Garder est le défaut : il faut taper « s » pour supprimer, et c'est DÉFINITIF.
#
# Supprimer une session efface AUSSI tout ce qu'elle possède ailleurs :
# sous-agents, file-history/, session-env/, tasks/, teams/, jobs/, uploads/,
# debug/, ses collages, son instantané de shell et ses lignes de history.jsonl.
# Rien n'est effacé hors de ~/.claude, et jamais un répertoire memory/.
#
# Portable bash 3.2+, GNU/BSD/macOS. Dépend de jq et claude.

set -uo pipefail
. "$(dirname "$0")/gld-lib.sh"

AGE_MAX=${GLD_AGE:-${CC_AGE:-3650}}
TAILLE_MIN=0
DRY=0; FORCE=0; ORPHELINS=0; TOUT=0; PARTOUT=0; ORDRE="ancien"; CIBLE=""

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run)  DRY=1 ;;
    -f|--force)    FORCE=1 ;;
    --recent)      ORDRE="recent" ;;
    --orphelins)   ORPHELINS=1 ;;
    --tout)        TOUT=1 ;;
    --partout)     TOUT=1; PARTOUT=1 ;;
    --age)         AGE_MAX="${2:-}"; shift ;;
    --min)         TAILLE_MIN="${2:-}"; shift ;;
    -h|--help)     sed -n '2,${/^#/!q; s/^# \{0,1\}//; p;}' "$0"; exit 0 ;;
    -*)            echo "gld-trier: option inconnue: $1" >&2; exit 2 ;;
    *)             CIBLE="$1" ;;
  esac
  shift
done

# Lit une réponse au clavier. En temps normal : le terminal (/dev/tty), pour ne
# pas confondre avec un éventuel pipe. GLD_TRIER_STDIN=1 force stdin (tests).
lire() {
  if [ "${GLD_TRIER_STDIN:-${CC_TRIER_STDIN:-0}}" = 1 ]; then read -r REP || REP=q
  elif [ -c /dev/tty ]; then read -r REP < /dev/tty || REP=q
  else echo "gld-trier: pas de terminal interactif (essayez GLD_TRIER_STDIN=1)" >&2; exit 1
  fi
}

# --- balayage des orphelins --------------------------------------------------

# Entrées d'un store dont la session n'existe plus.
# $1 store, $2 fichier des clés connues, $3 préfixe de nom, $4 suffixe,
# $5 type attendu (d ou f).
orphelins_de() {
  store="$GLD_ROOT/$1"; connu="$2"; pre="$3"; suf="$4"; typ="$5"
  [ -d "$store" ] || return 0
  # ls suffit : les noms sont des UUID ou des hachages, sans espace ni glob.
  # shellcheck disable=SC2012
  ls -A -- "$store" 2>/dev/null \
    | sed -n "s|^${pre}\(.*\)${suf}\$|\1|p" | sort -u > "$GLD_TMP/cles"
  comm -13 "$connu" "$GLD_TMP/cles" | while IFS= read -r cle; do
    p="$store/$pre$cle$suf"
    [ -L "$p" ] && continue
    case "$typ" in
      d) [ -d "$p" ] || continue ;;
      *) [ -f "$p" ] || continue ;;
    esac
    printf '%s\n' "$p"
  done | sans_les_recents
}

# Dresse la liste de tout ce qui n'appartient plus à aucune session, une
# catégorie par fichier $GLD_TMP/c.<catégorie>. Pose CATS.
CATS=""
inventaire() {
  cc_tmp
  CATS="file-history session-env tasks teams jobs uploads debug paste-cache shell-snapshots projets-vides divers"
  find "$GLD_ROOT/projects" -maxdepth 2 -name '*.jsonl' 2>/dev/null \
    | sed 's|.*/||; s|\.jsonl$||' | sort -u > "$GLD_TMP/connues"
  sessions_vivantes 2>/dev/null | grep -v '^$' >> "$GLD_TMP/connues"
  sort -u -o "$GLD_TMP/connues" "$GLD_TMP/connues"
  cut -c1-8 "$GLD_TMP/connues" | sort -u > "$GLD_TMP/courtes"

  orphelins_de file-history "$GLD_TMP/connues" ''         ''     d > "$GLD_TMP/c.file-history"
  orphelins_de session-env  "$GLD_TMP/connues" ''         ''     d > "$GLD_TMP/c.session-env"
  orphelins_de uploads      "$GLD_TMP/connues" ''         ''     d > "$GLD_TMP/c.uploads"
  orphelins_de debug        "$GLD_TMP/connues" ''         '.txt' f > "$GLD_TMP/c.debug"
  orphelins_de tasks        "$GLD_TMP/courtes" 'session-' ''     d > "$GLD_TMP/c.tasks"
  orphelins_de teams        "$GLD_TMP/courtes" 'session-' ''     d > "$GLD_TMP/c.teams"
  orphelins_de jobs         "$GLD_TMP/courtes" ''         ''     d > "$GLD_TMP/c.jobs"

  # history.jsonl : les prompts dont la session n'a plus de transcript.
  jq -r '.sessionId // empty' "$GLD_ROOT/history.jsonl" 2>/dev/null \
    | sort -u | comm -13 "$GLD_TMP/connues" - > "$GLD_TMP/c.history"
  motifs_sessions "$GLD_TMP/motifs" < "$GLD_TMP/c.history"

  # Stores partagés : ce que plus personne ne cite, une fois history élagué.
  { grep -rhoE 'snapshot-[a-zA-Z]+-[0-9]+-[a-zA-Z0-9]+\.sh|[0-9a-f]{16}' \
      "$GLD_ROOT/projects" 2>/dev/null
    if [ -s "$GLD_TMP/motifs" ]; then
      grep -F -v -f "$GLD_TMP/motifs" "$GLD_ROOT/history.jsonl" 2>/dev/null
    else
      cat "$GLD_ROOT/history.jsonl" 2>/dev/null
    fi | jq -r '.pastedContents[]?.contentHash // empty' 2>/dev/null
  } | sort -u > "$GLD_TMP/refs"

  # shellcheck disable=SC2012
  ls -A -- "$GLD_ROOT/paste-cache" 2>/dev/null | sed -n 's|\.txt$||p' | sort -u \
    | comm -13 "$GLD_TMP/refs" - | sed "s|^|$GLD_ROOT/paste-cache/|; s|\$|.txt|" \
    | sans_les_recents > "$GLD_TMP/c.paste-cache"
  # shellcheck disable=SC2012
  ls -A -- "$GLD_ROOT/shell-snapshots" 2>/dev/null | sort -u \
    | comm -13 "$GLD_TMP/refs" - | sed "s|^|$GLD_ROOT/shell-snapshots/|" \
    | sans_les_recents > "$GLD_TMP/c.shell-snapshots"

  # Répertoires de projet devenus vides (jamais ceux qui gardent un memory/).
  find "$GLD_ROOT/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | while IFS= read -r p; do
        [ -n "$(ls -A -- "$p" 2>/dev/null)" ] && continue
        printf '%s\n' "$p"
      done | sans_les_recents > "$GLD_TMP/c.projets-vides"

  # Lien debug/latest devenu pendant.
  : > "$GLD_TMP/c.divers"
  if [ -L "$GLD_ROOT/debug/latest" ] && [ ! -e "$GLD_ROOT/debug/latest" ]; then
    printf '%s\n' "$GLD_ROOT/debug/latest" > "$GLD_TMP/c.divers"
  fi
}

nb_orphelins() {
  n=$(nblignes "$GLD_TMP/c.history")
  for c in $CATS; do n=$((n + $(nblignes "$GLD_TMP/c.$c"))); done
  echo "$n"
}

balayer() {
  inventaire

  total=0; rien=1
  : > "$GLD_TMP/tableau"
  for c in $CATS; do
    n=$(nblignes "$GLD_TMP/c.$c")
    [ "$n" -gt 0 ] || continue
    ko=$(poids_ko "$GLD_TMP/c.$c")
    total=$((total + ko)); rien=0
    printf '  %-16s %5s   %8s\n' "$c" "$n" "$(humain "$ko")" >> "$GLD_TMP/tableau"
  done
  nh=$(nblignes "$GLD_TMP/c.history")
  [ "$nh" -gt 0 ] && { rien=0
    printf '  %-16s %5s   %8s\n' "history.jsonl" "$nh" "session(s)" >> "$GLD_TMP/tableau"; }

  [ "$rien" = 0 ] || { echo "rien à balayer dans $GLD_ROOT."; exit 0; }

  echo "restes trouvés dans $GLD_ROOT :"
  echo
  cat "$GLD_TMP/tableau"
  echo
  printf '  %-16s %5s   %8s\n' "total" "" "$(humain "$total")"
  echo

  if [ "$DRY" = 1 ]; then
    echo "inventaire seul. Lancez sans -n pour effacer."
    exit 0
  fi
  if [ "$FORCE" != 1 ]; then
    printf 'Effacer DÉFINITIVEMENT ces restes ? [tapez oui] '
    lire
    [ "$REP" = "oui" ] || { echo "annulé."; exit 1; }
  fi

  n=0
  for c in $CATS; do
    n=$((n + $(effacer_liste "$GLD_TMP/c.$c")))
  done
  nh=$(elaguer_history "$GLD_TMP/motifs")

  echo
  printf '%s emplacement(s) effacé(s), %s récupérés' "$n" "$(humain "$total")"
  [ "$nh" -gt 0 ] && printf ', %s ligne(s) de history.jsonl retirée(s)' "$nh"
  echo "."
  exit 0
}

# --- balayage seul -----------------------------------------------------------

if [ "$ORPHELINS" = 1 ] && [ "$TOUT" != 1 ]; then
  command -v jq >/dev/null || { echo "gld-trier: jq requis" >&2; exit 1; }
  command -v claude >/dev/null || { echo "gld-trier: claude introuvable" >&2; exit 1; }
  balayer
fi

# --- tri, session par session ------------------------------------------------

if [ "$PARTOUT" = 1 ]; then
  command -v jq >/dev/null || { echo "gld-trier: jq requis" >&2; exit 1; }
  command -v claude >/dev/null || { echo "gld-trier: claude introuvable" >&2; exit 1; }
else
  resoudre_projet "$CIBLE"
fi

# Compte les VRAIS sous-agents (des conversations), pas les tool-results déportés.
nb_subagents() {
  sub="${1%.jsonl}"
  [ -d "$sub" ] || { echo 0; return; }
  find "$sub" -type f -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' '
}

# Affiche les 3 premiers prompts utilisateur d'une session (action « voir »).
apercu() {
  head -400 "$1" \
    | jq -r 'select(.type=="user")
             | .message.content
             | if type=="string" then . else ([.[]?|select(.type=="text").text]|join(" ")) end' 2>/dev/null \
    | grep -v '^[[:space:]]*$' | grep -v '^<' | grep -vi '^caveat:' \
    | head -3 | cut -c1-100 | sed 's/^/       │ /'
}

# Sessions supprimables d'un répertoire de transcripts : ni vivantes, ni hors
# des filtres d'âge et de taille. Un id par ligne.
candidates() {
  # ls trie par date (impossible avec un glob seul) ; les noms sont des UUID
  # sans espace ni retour ligne, l'itération est sûre.
  # shellcheck disable=SC2045
  for f in $(ls "$LSOPT" "$1"/*.jsonl 2>/dev/null); do
    [ -s "$f" ] || continue
    [ "$(taille "$f")" -ge "$TAILLE_MIN" ] || continue
    find "$f" -mtime -"$AGE_MAX" 2>/dev/null | grep -q . || continue
    id=$(basename "$f" .jsonl)
    printf '%s\n' "$VIVANTES" | grep -Fq -- "$id" && continue
    printf '%s\n' "$id"
  done
}

# Une ligne « répertoire<TAB>id » par session du lot.
TAB=$(printf '\t')
ligne_lot() { printf '%s\t%s\n' "$1" "$2"; }

# Affiche une session du lot : date, titre, id, taille, sous-agents.
afficher_session() {
  f="$1/$2.jsonl"
  t=$(titre_explicite "$f"); [ -n "$t" ] || t="~ $(etiquette_deduite "$f")"
  printf '  %-9s %-45s %s  %6sK  %s sous-agent(s)\n' \
    "$(mdate "$f")" "$(printf '%.45s' "$t")" "$(printf '%.8s' "$2")" \
    "$(( $(taille "$f") / 1024 ))" "$(nb_subagents "$f")"
}

# Supprime tout le lot, sans rien demander. Écrit le compte.
supprimer_lot() {
  n=0
  while IFS="$TAB" read -r d id; do
    [ -n "$id" ] || continue
    snapshots_cites "$d/$id.jsonl" "$d/$id" >> "$GLD_TMP/snapshots"
    purger_session "$d" "$id" > /dev/null
    printf '%s\n' "$id" >> "$GLD_TMP/supprimees"
    n=$((n + 1))
  done < "$GLD_TMP/lot"
  echo "$n"
}

LSOPT="-tr"; [ "$ORDRE" = "recent" ] && LSOPT="-t"
VIVANTES=$(sessions_vivantes)
cc_tmp
: > "$GLD_TMP/supprimees"; : > "$GLD_TMP/snapshots"; : > "$GLD_TMP/lot"

if [ "$PARTOUT" = 1 ]; then
  echo "projets : tous ceux de $GLD_ROOT/projects"
  find "$GLD_ROOT/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort \
    | while IFS= read -r d; do
        candidates "$d" | while IFS= read -r id; do ligne_lot "$d" "$id"; done
      done > "$GLD_TMP/lot"
else
  echo "projet : $PROJET"
  [ -n "$TRANSCRIPTS_ALIAS" ] && echo "         (répertoire additionnel : sessions rangées dans ${TRANSCRIPTS_ALIAS##*/})"
  candidates "$TRANSCRIPTS" | while IFS= read -r id; do
    ligne_lot "$TRANSCRIPTS" "$id"
  done > "$GLD_TMP/lot"
fi

total=$(nblignes "$GLD_TMP/lot")
echo "sessions non ouvertes : $total  (ordre : $([ "$ORDRE" = recent ] && echo 'récent→ancien' || echo 'ancien→récent'))"
echo

[ "$total" -gt 0 ] || { echo "rien à trier."; exit 0; }

# --- suppression en bloc -----------------------------------------------------

if [ "$TOUT" = 1 ] || [ "$DRY" = 1 ]; then
  projet_courant=""
  while IFS="$TAB" read -r d id; do
    if [ "$PARTOUT" = 1 ] && [ "$d" != "$projet_courant" ]; then
      projet_courant="$d"; printf '\n  %s\n' "${d##*/}"
    fi
    afficher_session "$d" "$id"
  done < "$GLD_TMP/lot"
  echo

  awk -F'\t' '{print $1 "/" $2 ".jsonl"; print $1 "/" $2}' "$GLD_TMP/lot" > "$GLD_TMP/lotpaths"
  poids=$(poids_ko "$GLD_TMP/lotpaths")

  if [ "$DRY" = 1 ]; then
    echo "$total candidate(s), $(humain "$poids"). Lancez sans -n pour $([ "$TOUT" = 1 ] && echo 'supprimer' || echo 'trier')."
    exit 0
  fi

  if [ "$FORCE" != 1 ]; then
    printf 'Supprimer DÉFINITIVEMENT ces %s session(s) (%s) ? [tapez oui] ' "$total" "$(humain "$poids")"
    lire
    [ "$REP" = "oui" ] || { echo "annulé."; exit 1; }
  fi

  supp=$(supprimer_lot)
  echo
  echo "$supp session(s) supprimée(s)."
  solder "$GLD_TMP/supprimees" "$GLD_TMP/snapshots"

  if [ "$ORPHELINS" = 1 ]; then
    echo
    balayer
  fi
  inventaire
  reste=$(nb_orphelins)
  [ "$reste" -gt 0 ] && \
    echo "($reste reste(s) d'anciennes suppressions ailleurs dans ~/.claude — gld-trier --orphelins)"
  exit 0
fi

# --- passage en revue --------------------------------------------------------

CAND=$(cut -f2 "$GLD_TMP/lot")

# Fige la liste dans les paramètres positionnels : itérer dessus n'utilise pas
# stdin, qu'on garde libre pour lire les réponses.
set -f; IFS='
'
# shellcheck disable=SC2086
set -- $CAND
unset IFS; set +f

i=1; supp=0
while [ "$i" -le "$#" ]; do
  id=$(eval "printf '%s' \"\${$i}\"")
  f="$TRANSCRIPTS/$id.jsonl"
  if [ ! -f "$f" ]; then i=$((i + 1)); continue; fi

  t=$(titre_explicite "$f"); marque=' '
  [ -n "$t" ] || { t="$(etiquette_deduite "$f")"; marque='~'; }
  ns=$(nb_subagents "$f")

  echo   "──────────────────────────────────────────────────────────────"
  printf '[%s/%s]  %s   %s   %sK\n' "$i" "$#" "$(mdate "$f")" "$(printf '%.8s' "$id")" "$(( $(taille "$f") / 1024 ))"
  printf '   %s %s\n' "$marque" "${t:-(sans titre ni prompt)}"
  [ "$ns" -gt 0 ] && printf '   \033[33m⚠ %s sous-agent(s) seront aussi supprimés\033[0m\n' "$ns"

  printf '   [Entrée]=garder  s=supprimer  v=voir  q=quitter > '
  lire
  case "$REP" in
    s|S|sup*|oui)
      # Relever avant de détruire : le nom de l'instantané de shell ne vit que
      # dans le transcript.
      snapshots_cites "$f" "$TRANSCRIPTS/$id" >> "$GLD_TMP/snapshots"
      n=$(purger_session "$TRANSCRIPTS" "$id" | wc -l | tr -d ' ')
      printf '%s\n' "$id" >> "$GLD_TMP/supprimees"
      printf '   → supprimée (%s emplacement(s) nettoyé(s)).\n' "$n"
      supp=$((supp + 1)); i=$((i + 1)) ;;
    v|V|voir)
      echo "   prompts :"; apercu "$f" ;;                # ne pas avancer
    q|Q|quit*)
      echo "   → arrêt."; break ;;
    *)
      echo "   → gardée."; i=$((i + 1)) ;;
  esac
done

echo "──────────────────────────────────────────────────────────────"
echo "$supp session(s) supprimée(s)."

if [ "$supp" -gt 0 ]; then
  solder "$GLD_TMP/supprimees" "$GLD_TMP/snapshots"

  # Reste-t-il des traces d'anciennes suppressions, faites avant que gld-trier
  # ne nettoie tout ? On le signale sans rien toucher.
  inventaire
  reste=$(nb_orphelins)
  [ "$reste" -gt 0 ] && \
    echo "($reste reste(s) d'anciennes suppressions ailleurs dans ~/.claude — gld-trier --orphelins)"
fi

exit 0
