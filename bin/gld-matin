#!/usr/bin/env bash
# gld-matin — rouvre chaque sujet Claude d'un projet dans un onglet de terminal.
#
#   gld-matin                      onglets pour le projet courant ($PWD)
#   gld-matin -n                   dry-run : affiche, n'ouvre rien
#   gld-matin ~/Projets/autre      cible un autre projet
#   gld-matin --term tmux          force un lanceur (défaut : auto-détecté)
#   gld-matin --term list          liste les lanceurs disponibles ici
#   gld-matin --age 40 --min 0     élargit la fenêtre (jours) et le seuil (octets)
#   gld-matin --nommees            ignore les sessions sans nom explicite
#   gld-matin --id <uuid> [projet] rouvre cette seule session (sans filtre d'âge ni de taille)
#   gld-matin --args "..."          options ajoutées à `claude` (défaut : aucune, ou $GLD_MATIN_ARGS)
#                                 ex. --args --dangerously-skip-permissions
#   gld-matin --resume [nom]       rouvre les sessions de la dernière sauvegarde de gld-web
#                                 (ou de la sauvegarde manuelle de ce nom), ex. après un redémarrage
#   gld-matin --prompt "..." [projet]  ouvre une NOUVELLE session claude avec ce prompt
#                                 (avec --id : reprend cette session en lui envoyant ce message)
#
# Un sujet = une session Claude. On le désigne par son nom quand vous en avez
# donné un, sinon (marqué «~») par son premier prompt. On résout ce libellé
# vers l'ID du transcript le plus récent, puis `claude --resume <id>`
# (--resume exige un ID : un nom n'est qu'un terme de recherche interactif).
#
# Portabilité : bash 3.2+, POSIX/BSD/GNU. Dépend de jq et claude.

set -uo pipefail
export LC_ALL=C   # rend le tri et le sed d'encodage indépendants de la locale

AGE_MAX=${GLD_MATIN_AGE:-${CC_MATIN_AGE:-7}}          # jours : ne rouvre que le chantier courant
TAILLE_MIN=${GLD_MATIN_MIN:-${CC_MATIN_MIN:-50000}}   # octets : écarte les sessions nommées mais vides
PAUSE=${GLD_MATIN_PAUSE:-${CC_MATIN_PAUSE:-0.7}}        # respiration entre deux onglets
ARGS=${GLD_MATIN_ARGS:-${CC_MATIN_ARGS:-}}           # options passées à claude ; vide par défaut
EXCLURE=${GLD_MATIN_EXCLURE:-${CC_MATIN_EXCLURE:-}}       # noms à ignorer, séparés par ':'

DRY=0; ID=""; PROJET=""; RESUME=0; RESUME_NOM=""; PROMPT=""; TERMCHOIX="${GLD_MATIN_TERM:-${CC_MATIN_TERM:-}}"; NOMMEES_SEULES=0
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY=1 ;;
    --nommees)    NOMMEES_SEULES=1 ;;
    --id)         ID="${2:-}"; shift ;;
    --args)       ARGS="${2:-}"; shift ;;
    --prompt)     PROMPT="${2:-}"; shift ;;
    --resume)     RESUME=1
                  case "${2:-}" in ''|-*) ;; *) RESUME_NOM="$2"; shift ;; esac ;;
    --term)       TERMCHOIX="${2:-}"; shift ;;
    --age)        AGE_MAX="${2:-}"; shift ;;
    --min)        TAILLE_MIN="${2:-}"; shift ;;
    -h|--help)    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           echo "gld-matin: option inconnue: $1" >&2; exit 2 ;;
    *)            PROJET="$1" ;;
  esac
  shift
done

# --- reprise d'une sauvegarde de gld-web (~/.claude/gld-web-tabs.json) -------------
# Chaque session est rouverte par un appel à soi-même avec --id : même lanceur, mêmes règles
# (sessions déjà ouvertes épargnées, -n respecté).
if [ "$RESUME" = 1 ]; then
  command -v jq >/dev/null || { echo "gld-matin: jq requis" >&2; exit 1; }
  FICHIER="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/gld-web-tabs.json"
  [ -s "$FICHIER" ] || FICHIER="${FICHIER%/*}/cc-web-tabs.json"   # ancien nom, avant la première migration
  [ -s "$FICHIER" ] || { echo "gld-matin: aucune sauvegarde ($FICHIER)" >&2; exit 1; }
  if [ -n "$RESUME_NOM" ]; then CHOIX='[.[] | select(.name == $n)][0]'; else CHOIX='.[0]'; fi
  SAUVE=$(jq -c --arg n "$RESUME_NOM" "$CHOIX // empty" "$FICHIER")
  [ -n "$SAUVE" ] || { echo "gld-matin: sauvegarde introuvable : $RESUME_NOM" >&2; exit 1; }
  printf '%s' "$SAUVE" | jq -r '"sauvegarde : \(if .name != "" then .name else "automatique" end) du \(.at[0:16] | sub("T"; " ")), \(.sessions | length) session(s)"'
  OPTS=()
  [ "$DRY" = 1 ] && OPTS+=(-n)
  [ -n "$TERMCHOIX" ] && OPTS+=(--term "$TERMCHOIX")
  [ -n "$ARGS" ] && OPTS+=(--args "$ARGS")
  printf '%s' "$SAUVE" | jq -r '.sessions[] | [.id, .project] | @tsv' \
    | while IFS="$(printf '\t')" read -r id proj; do
        echo
        "$0" ${OPTS[@]+"${OPTS[@]}"} --id "$id" "$proj"
      done
  exit 0
fi

# --- helpers portables -------------------------------------------------------

# Échappe pour insertion dans une commande shell entre quotes simples.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Taille en octets : wc -c est POSIX, contrairement à stat -c/-f.
taille() { wc -c < "$1" | tr -d ' '; }

# Date de modification lisible : GNU `date -r`, sinon BSD `stat -f`.
mdate() {
  date -r "$1" +%m-%d_%H:%M 2>/dev/null \
    || stat -f '%Sm' -t '%m-%d_%H:%M' "$1" 2>/dev/null \
    || echo '?'
}

# Titre explicite de la session, s'il y en a un. Le DERNIER écrit fait foi :
# Claude réémet la ligne custom-title en continu (des centaines par fichier)
# et un renommage s'ajoute à la fin. Lire le premier renvoyait le nom d'origine
# — d'où les onglets «tornab» pour une session renommée «Torznab».
titre_explicite() {
  grep '"custom-title"' "$1" 2>/dev/null \
    | tail -1 \
    | jq -r '.customTitle // empty' 2>/dev/null
}

# Repli pour les sessions jamais nommées : le premier vrai prompt utilisateur.
# On écarte le bruit d'amorçage (system-reminder, attachments, <command-*>,
# résultats d'outils) pour ne garder que ce que vous avez tapé.
etiquette_deduite() {
  head -200 "$1" \
    | jq -r 'select(.type=="user")
             | .message.content
             | if type == "string" then .
               else ([.[]? | select(.type == "text") | .text] | join(" "))
               end' 2>/dev/null \
    | tr '\t' ' ' \
    | grep -v '^[[:space:]]*$' \
    | grep -v '^<' \
    | grep -vi '^caveat:' \
    | head -1 \
    | cut -c1-45
}

# --- lanceurs de terminal ----------------------------------------------------
# Chacun ouvre un ONGLET intitulé $1 exécutant le shell $2.

dispo() {
  case "$1" in
    tmux)      [ -n "${TMUX:-}" ] && command -v tmux >/dev/null ;;
    kitty)     [ -n "${KITTY_LISTEN_ON:-}" ] && command -v kitty >/dev/null ;;
    wezterm)   [ -n "${WEZTERM_PANE:-}" ] && command -v wezterm >/dev/null ;;
    *)         command -v "$1" >/dev/null ;;
  esac
}

# Ordre de préférence : le multiplexeur courant d'abord, puis les émulateurs.
LANCEURS="tmux kitty wezterm terminator gnome-terminal konsole xfce4-terminal tilix"

ouvrir() {
  titre="$1"; cmd="$2"
  case "$TERM_UTILISE" in
    tmux)           tmux new-window -n "$titre" "$cmd" ;;
    kitty)          kitty @ launch --type=tab --tab-title "$titre" sh -c "$cmd" >/dev/null ;;
    wezterm)        wezterm cli spawn -- sh -c "$cmd" >/dev/null ;;
    terminator)     terminator --new-tab -T "$titre" -e "sh -c $(shq "$cmd")" >/dev/null 2>&1 & ;;
    gnome-terminal) gnome-terminal --tab --title="$titre" -- sh -c "$cmd" >/dev/null 2>&1 ;;
    konsole)        konsole --new-tab -p "tabtitle=$titre" -e sh -c "$cmd" >/dev/null 2>&1 & ;;
    xfce4-terminal) xfce4-terminal --tab -T "$titre" -e "sh -c $(shq "$cmd")" >/dev/null 2>&1 & ;;
    tilix)          tilix --action=app-new-session -e "sh -c $(shq "$cmd")" >/dev/null 2>&1 & ;;
    *)              echo "gld-matin: lanceur inconnu: $TERM_UTILISE" >&2; return 1 ;;
  esac
}

if [ "$TERMCHOIX" = "list" ]; then
  echo "lanceurs disponibles ici :"
  for l in $LANCEURS; do dispo "$l" && echo "  $l"; done
  exit 0
fi

TERM_UTILISE=""
if [ -n "$TERMCHOIX" ]; then
  TERM_UTILISE="$TERMCHOIX"
else
  for l in $LANCEURS; do dispo "$l" && { TERM_UTILISE="$l"; break; }; done
fi

# --- nouvelle session avec un prompt (ex. fusion de mémoires depuis gld-web) ------
if [ -n "$PROMPT" ] && [ -z "$ID" ]; then
  PROJET="$(cd "${PROJET:-$PWD}" 2>/dev/null && pwd)" \
    || { echo "gld-matin: projet introuvable" >&2; exit 1; }
  cmd="cd $(shq "$PROJET") && exec env PATH=$(shq "$HOME/.local/bin:$PATH") claude ${ARGS:+$ARGS }-- $(shq "$PROMPT")"
  if [ "$DRY" = 1 ]; then
    echo "ouvrirait une nouvelle session dans $PROJET"
  else
    [ -n "$TERM_UTILISE" ] || { echo "gld-matin: aucun terminal supporté détecté (--term list)" >&2; exit 1; }
    ouvrir "claude" "$cmd" && echo "1 onglet lancé : nouvelle session dans $PROJET."
  fi
  exit 0
fi

[ -z "$ID" ] || { AGE_MAX=36500; TAILLE_MIN=0; }

# --- localisation du projet et de ses transcripts ----------------------------

command -v jq >/dev/null || { echo "gld-matin: jq requis" >&2; exit 1; }

PROJET="$(cd "${PROJET:-$PWD}" 2>/dev/null && pwd)" \
  || { echo "gld-matin: projet introuvable" >&2; exit 1; }

# Encodage Claude : tout caractère non alphanumérique devient '-'.
# Transformation exacte, jamais un préfixe : «…-crawl-center» préfixe
# «…-crawl-center-agent», deux projets bien distincts.
CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
TRANSCRIPTS="$CFG/projects/$(printf '%s' "$PROJET" | sed 's/[^a-zA-Z0-9]/-/g')"

[ -d "$TRANSCRIPTS" ] || {
  echo "gld-matin: aucune session Claude pour $PROJET" >&2
  echo "          (cherché dans $TRANSCRIPTS)" >&2
  exit 1
}

[ -n "$TERM_UTILISE" ] || [ "$DRY" = 1 ] || {
  echo "gld-matin: aucun terminal supporté détecté. --term list pour voir," >&2
  echo "          ou --term <nom> pour en forcer un." >&2
  exit 1
}

echo "projet : $PROJET"
[ "$DRY" = 1 ] || echo "onglets: $TERM_UTILISE"
echo

# --- sélection ---------------------------------------------------------------

# Sessions déjà vivantes : on ne les rouvre pas par-dessus.
VIVANTES=$(claude agents --json 2>/dev/null | jq -r '.[].sessionId' 2>/dev/null || true)

# find -mtime est POSIX (contrairement à -printf) ; ls -t donne l'ordre récent.
# Les noms sont des UUID : pas d'espace, le découpage par mots est sûr.
RECENTS=$(find "$TRANSCRIPTS" -maxdepth 1 -name '*.jsonl' -mtime -"$AGE_MAX" 2>/dev/null)
[ -n "$RECENTS" ] || { echo "aucune session de moins de $AGE_MAX jours."; exit 0; }

VUS=""   # noms déjà rencontrés (bash 3.2 n'a pas les tableaux associatifs)
n=0

for f in $(ls -t $RECENTS); do
  [ -s "$f" ] || continue
  [ -z "$ID" ] || [ "$(basename "$f" .jsonl)" = "$ID" ] || continue
  [ "$(taille "$f")" -ge "$TAILLE_MIN" ] || continue

  marque=' '
  titre=$(titre_explicite "$f")
  [ "$titre" = "null" ] && titre=""

  # Session jamais nommée : on la désigne par son premier prompt.
  if [ -z "$titre" ]; then
    [ "$NOMMEES_SEULES" = 1 ] && continue
    titre=$(etiquette_deduite "$f")
    marque='~'
  fi
  [ -n "$titre" ] || continue

  # Premier vu = plus récent : les homonymes plus anciens sont ignorés.
  [ -z "$ID" ] && printf '%s\n' "$VUS" | grep -Fxq -- "$titre" && continue
  VUS="$VUS
$titre"

  printf '%s' ":$EXCLURE:" | grep -Fq -- ":$titre:" && continue

  id=$(basename "$f" .jsonl)
  if printf '%s\n' "$VIVANTES" | grep -Fq -- "$id"; then
    printf '  déjà ouverte %s %-45s %s\n' "$marque" "$titre" "$(printf '%.8s' "$id")"
    continue
  fi

  if [ "$DRY" = 1 ]; then
    printf '  ouvrirait    %s %-45s %s  (%s)\n' "$marque" "$titre" "$(printf '%.8s' "$id")" "$(mdate "$f")"
  else
    printf '  ouvre        %s %-45s %s\n' "$marque" "$titre" "$(printf '%.8s' "$id")"
    ouvrir "$titre" "cd $(shq "$PROJET") && exec env PATH=$(shq "$HOME/.local/bin:$PATH") claude ${ARGS:+$ARGS }--resume $id${PROMPT:+ -- $(shq "$PROMPT")}" || true
    sleep "$PAUSE"
  fi
  n=$((n + 1))
done

echo
if [ "$DRY" = 1 ]; then
  echo "$n sujet(s) seraient rouverts. Lancez sans -n pour ouvrir."
else
  echo "$n onglet(s) lancé(s)."
fi
